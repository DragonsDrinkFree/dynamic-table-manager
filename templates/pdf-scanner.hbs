{{!-- PDF Scanner Window --}}
<div class="dtm-scanner-container">

  {{!-- LEFT: PDF viewer --}}
  <div class="dtm-scanner-left">
    <div class="dtm-scanner-toolbar">
      <button type="button" data-action="selectPdf" class="dtm-btn-secondary">
        <i class="fas fa-folder-open"></i> Select PDF
      </button>
      <button type="button" data-action="selectSingleToolbox"
              class="dtm-btn-secondary{{#if isSelectSingleToolbox}} dtm-active{{/if}}"
              {{#unless hasPdf}}disabled{{/unless}}
              title="Single-column table tools">
        <i class="fas fa-list-ol"></i> Single Col
      </button>
      <button type="button" data-action="selectMultiToolbox"
              class="dtm-btn-secondary{{#if isSelectMultiToolbox}} dtm-active{{/if}}"
              {{#unless hasPdf}}disabled{{/unless}}
              title="Multi-column table tools">
        <i class="fas fa-table-cells"></i> Multi Col
      </button>
      <button type="button" data-action="selectTextScan"
              class="dtm-btn-secondary{{#if isSelectTextScan}} dtm-active{{/if}}"
              {{#unless hasPdf}}disabled{{/unless}}
              title="Draw regions over formatted prose blocks (e.g. Name: Description… lists). Regions are added to the active group; apply rules to finalise it and start a new group.">
        <i class="fas fa-align-left"></i> Text Scan
      </button>
      <button type="button" data-action="importRecipe" class="dtm-btn-secondary"
              {{#unless hasPdf}}disabled{{/unless}}
              title="Load a recipe JSON and re-scan its regions on this PDF">
        <i class="fas fa-file-import"></i> Import Recipe
      </button>
      <button type="button" data-action="exportRecipe" class="dtm-btn-secondary"
              {{#unless hasRegions}}disabled{{/unless}}
              title="Save current regions + options as JSON (no table content)">
        <i class="fas fa-file-export"></i> Export Recipe
      </button>
      {{#if hasPdf}}
      <div class="dtm-page-nav">
        <button type="button" data-action="prevPage" {{#if isFirstPage}}disabled{{/if}}>
          <i class="fas fa-chevron-left"></i>
        </button>
        <input type="number" class="dtm-page-input" value="{{currentPage}}" min="1" max="{{totalPages}}" title="Go to page">
        <span class="dtm-page-total">/ {{totalPages}}</span>
        <button type="button" data-action="nextPage" {{#if isLastPage}}disabled{{/if}}>
          <i class="fas fa-chevron-right"></i>
        </button>
      </div>
      {{/if}}
    </div>

    {{!-- Sub-toolbar: shown when a toolbox is open --}}
    <div class="dtm-subtoolbar"{{#unless toolboxOpen}} hidden{{/unless}}>
      <button type="button" data-action="selectSinglePage"
              class="dtm-btn-secondary{{#if isSelectSinglePage}} dtm-active{{/if}}"
              {{#unless hasPdf}}disabled{{/unless}}
              title="Draw one region for a single-page table scan">
        <i class="fas fa-file"></i> Single Page
      </button>
      <button type="button" data-action="selectMultiPage"
              class="dtm-btn-secondary{{#if isSelectMultiPage}} dtm-active{{/if}}"
              {{#unless hasPdf}}disabled{{/unless}}
              title="Draw multiple regions across pages — they merge into one table">
        <i class="fas fa-copy"></i> Multi Page
      </button>
      <button type="button" data-action="selectSlice"
              class="dtm-btn-secondary{{#if isSelectSlice}} dtm-active{{/if}}"
              {{#unless hasPdf}}disabled{{/unless}}
              title="Draw one box per table entry — each box detected as a single result, immune to alignment issues">
        <i class="fas fa-scissors"></i> Slice
      </button>
    </div>

    <input type="file" id="dtm-pdf-file-input" accept=".pdf" style="display:none">
    <input type="file" id="dtm-recipe-file-input" accept="application/json,.json" style="display:none">

    <div class="dtm-canvas-wrapper">
      {{#unless hasPdf}}
      <div class="dtm-pdf-empty">
        <i class="fas fa-file-pdf"></i>
        <p>Click <strong>Select PDF</strong> to open a file.</p>
        <p class="dtm-pdf-empty-hint">Pick <strong>Single Col</strong> or <strong>Multi Col</strong> to choose a tool, then draw regions over table content. Use <strong>Multi Page</strong> to merge a table that spans multiple pages.</p>
      </div>
      {{/unless}}
      <canvas id="dtm-pdf-canvas"></canvas>
      <canvas id="dtm-select-canvas"></canvas>
    </div>
  </div>

  {{!-- RIGHT: Regions + Preview + Footer --}}
  <div class="dtm-scanner-right">

    <div class="dtm-region-list-header">
      <span>Tables</span>
      <span class="dtm-badge">{{totalRegionCount}}</span>
    </div>

    <div class="dtm-group-toolbar">
      <button type="button" data-action="addPrefixGroup" class="dtm-btn-secondary"
              {{#unless hasPdf}}disabled{{/unless}}
              title="Create a new prefix group (e.g. Elf, Fighter) and its first instance.">
        <i class="fas fa-plus"></i> Prefix Group
      </button>
      <button type="button" data-action="newGroupInstance" class="dtm-btn-secondary"
              {{#unless hasFamilies}}disabled{{/unless}}
              title="Add another instance that shares the active family's role template.">
        <i class="fas fa-layer-group"></i> New Instance
      </button>
    </div>

    <div class="dtm-region-list">

      {{!-- Prefix-grouped instances --}}
      {{#each instances}}
      <div class="dtm-instance-block">
        <div class="dtm-instance-header{{#if this.isActive}} dtm-instance-active{{/if}}"
             data-action="activateInstance" data-instance-id="{{this.id}}"
             title="Click to make this instance the active draw target">
          <button type="button" class="dtm-instance-chevron"
                  data-action="toggleInstanceExpand" data-instance-id="{{this.id}}"
                  title="Expand / collapse">
            <i class="fas {{#if this.isExpanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
          </button>
          <input type="text" class="dtm-instance-name" value="{{this.name}}"
                 placeholder="Instance name" data-instance-id="{{this.id}}"
                 title="Instance prefix (e.g. Elf, Dwarf)">
          <span class="dtm-badge">{{this.regions.length}}</span>
          <button type="button" class="dtm-instance-delete"
                  data-action="deleteInstance" data-instance-id="{{this.id}}"
                  title="Delete instance and all its regions">
            <i class="fas fa-trash"></i>
          </button>
        </div>
        {{#if this.isExpanded}}
        <div class="dtm-instance-regions">
          {{#each this.regions}}
          <div class="dtm-region-item{{#if this.isActive}} dtm-region-active{{/if}}"
               data-region-id="{{this.id}}">
            <input type="text" class="dtm-region-name" value="{{this.name}}" placeholder="Role name">
            {{#if this.isOverride}}<span class="dtm-badge dtm-override-badge" title="Per-region name override">~</span>{{/if}}
            <span class="dtm-badge dtm-mode-badge dtm-mode-{{this.mode}}" title="Extraction mode">{{this.mode}}</span>
            <span class="dtm-badge dtm-page-badge">p.{{this.page}}</span>
            <span class="dtm-badge">{{this.entryCount}} rows</span>
            <button type="button" data-action="previewRegion" title="Preview / hide preview">
              <i class="fas fa-eye"></i>
            </button>
            <button type="button" data-action="deleteRegion" title="Delete region">
              <i class="fas fa-trash"></i>
            </button>
          </div>
          {{/each}}
          {{#unless this.regions.length}}
          <div class="dtm-region-empty dtm-instance-empty">Empty &mdash; activate this instance and draw regions.</div>
          {{/unless}}
        </div>
        {{/if}}
      </div>
      {{/each}}

      {{!-- Text Scan groups — shown inline alongside normal groups --}}
      {{#each textScanGroups}}
      <div class="dtm-instance-block dtm-ts-group-block{{#if this.isActive}} dtm-ts-group-active{{/if}}"
           data-text-group-id="{{this.id}}"
           data-action="activateTextGroup"
           title="Click to make this group the active draw target for new regions">
        <div class="dtm-ts-group-header">
          <div class="dtm-ts-group-row-1">
            <button type="button" class="dtm-instance-chevron"
                    data-action="toggleGroupExpand" data-group-id="{{this.id}}"
                    title="Expand / collapse">
              <i class="fas {{#if this.isExpanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
            </button>
            <i class="fas fa-align-left dtm-ts-group-icon"></i>
            <input type="text" class="dtm-ts-group-name-input" value="{{this.name}}"
                   placeholder="Text Scan name" data-text-group-id="{{this.id}}" />
            <button type="button" data-action="editGroupRules" data-text-group-id="{{this.id}}"
                    class="dtm-btn-secondary dtm-ts-edit-btn"
                    title="Configure parsing rules and preview results">
              <i class="fas fa-sliders-h"></i> Edit Rules
            </button>
            <button type="button" data-action="deleteTextScanGroup" data-text-group-id="{{this.id}}"
                    class="dtm-icon-btn dtm-danger" title="Delete group and its regions">
              <i class="fas fa-trash"></i>
            </button>
          </div>
          <div class="dtm-ts-group-row-2">
            <span class="dtm-badge">{{this.regions.length}} regions</span>
            {{#if this.hasParsed}}
            <span class="dtm-badge dtm-ts-parsed-badge">{{this.entryCount}} entries</span>
            {{else}}
            <span class="dtm-ts-no-rules-hint">No rules applied yet</span>
            {{/if}}
          </div>
        </div>
        {{#if this.isExpanded}}
        {{#if this.regions.length}}
        <div class="dtm-instance-regions dtm-ts-region-list">
          {{#each this.regions}}
          <div class="dtm-ts-region-item">
            <i class="fas fa-file-pdf dtm-ts-region-icon"></i>
            <span class="dtm-ts-region-label">p.{{this.page}} — {{this.name}}</span>
            <button type="button" data-action="removeTextRegion" data-region-id="{{this.id}}"
                    class="dtm-icon-btn dtm-danger" title="Remove this region from the group">
              <i class="fas fa-times"></i>
            </button>
          </div>
          {{/each}}
        </div>
        {{/if}}
        {{/if}}
      </div>
      {{/each}}

      {{!-- Multi-page scan groups --}}
      {{#each multiPageGroups}}
      <div class="dtm-instance-block dtm-mp-group-block{{#if this.isActive}} dtm-mp-group-active{{/if}}"
           data-mp-group-id="{{this.id}}"
           data-action="activateMpGroup"
           title="Click to make this group the active draw target for new regions">
        <div class="dtm-mp-group-header">
          <div class="dtm-mp-group-row-1">
            <button type="button" class="dtm-instance-chevron"
                    data-action="toggleGroupExpand" data-group-id="{{this.id}}"
                    title="Expand / collapse">
              <i class="fas {{#if this.isExpanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
            </button>
            <i class="fas fa-copy dtm-mp-group-icon"></i>
            <input type="text" class="dtm-mp-group-name-input" value="{{this.name}}"
                   placeholder="Scan group name" data-mp-group-id="{{this.id}}" />
            <span class="dtm-badge dtm-mode-badge dtm-mode-{{this.mode}}" title="Extraction mode">{{this.mode}}</span>
            <button type="button" data-action="deleteMpGroup" data-mp-group-id="{{this.id}}"
                    class="dtm-icon-btn dtm-danger" title="Delete group and its regions">
              <i class="fas fa-trash"></i>
            </button>
          </div>
          <div class="dtm-mp-group-row-2">
            <span class="dtm-badge">{{this.regions.length}} regions</span>
            <span class="dtm-badge dtm-mp-entry-badge">{{this.totalEntryCount}} entries</span>
          </div>
        </div>
        {{#if this.isExpanded}}
        {{#if this.regions.length}}
        <div class="dtm-instance-regions dtm-mp-region-list">
          {{#each this.regions}}
          <div class="dtm-mp-region-item">
            <i class="fas fa-file-pdf dtm-mp-region-icon"></i>
            <span class="dtm-mp-region-label">p.{{this.page}} — {{this.name}}</span>
            <span class="dtm-badge">{{this.entryCount}}</span>
            <button type="button" data-action="removeMpRegion" data-region-id="{{this.id}}"
                    class="dtm-icon-btn dtm-danger" title="Remove this region from the group">
              <i class="fas fa-times"></i>
            </button>
          </div>
          {{/each}}
        </div>
        {{/if}}
        {{/if}}
      </div>
      {{/each}}

      {{!-- Slice scan groups --}}
      {{#each sliceGroups}}
      <div class="dtm-instance-block dtm-slice-group-block{{#if this.isActive}} dtm-slice-group-active{{/if}}"
           data-slice-group-id="{{this.id}}"
           data-action="activateSliceGroup"
           title="Click to make this the active slice group">
        <div class="dtm-slice-group-header">
          <div class="dtm-slice-group-row-1">
            <button type="button" class="dtm-instance-chevron"
                    data-action="toggleGroupExpand" data-group-id="{{this.id}}"
                    title="Expand / collapse">
              <i class="fas {{#if this.isExpanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i>
            </button>
            <i class="fas fa-scissors dtm-slice-group-icon"></i>
            <input type="text" class="dtm-slice-group-name-input" value="{{this.name}}"
                   placeholder="Slice group name" data-slice-group-id="{{this.id}}" />
            <button type="button" data-action="deleteSliceGroup" data-slice-group-id="{{this.id}}"
                    class="dtm-icon-btn dtm-danger" title="Delete group and its slices">
              <i class="fas fa-trash"></i>
            </button>
          </div>
          <div class="dtm-slice-group-row-2">
            <span class="dtm-badge">{{this.regionCount}} slices</span>
          </div>
        </div>
        {{#if this.isExpanded}}
        {{#if this.regions.length}}
        <div class="dtm-instance-regions dtm-slice-region-list">
          {{#each this.regions}}
          <div class="dtm-slice-region-item{{#if this.isImported}} dtm-slice-imported{{/if}}">
            {{#if this.isImported}}
            <i class="fas fa-layer-group dtm-slice-region-icon"></i>
            {{else}}
            <i class="fas fa-file-pdf dtm-slice-region-icon"></i>
            {{/if}}
            <span class="dtm-badge dtm-page-badge">p.{{this.page}}</span>
            {{#if this.hasRange}}
            <span class="dtm-badge dtm-slice-range-badge">{{this.rangeDisplay}}</span>
            {{else}}
            <span class="dtm-slice-range-missing" title="No range number detected — redraw the box to include the entry number">?</span>
            {{/if}}
            {{#if this.isImported}}
            <span class="dtm-badge dtm-slice-import-badge">{{this.entryCount}} entries</span>
            {{/if}}
            <span class="dtm-slice-region-label" title="{{this.namePreview}}">{{this.namePreview}}</span>
            <button type="button" data-action="removeSliceRegion" data-region-id="{{this.id}}"
                    class="dtm-icon-btn dtm-danger"
                    title="{{#if this.isImported}}Remove from group (returns to ungrouped){{else}}Remove this slice{{/if}}">
              <i class="fas fa-times"></i>
            </button>
          </div>
          {{/each}}
        </div>
        {{/if}}
        {{/if}}
      </div>
      {{/each}}

      {{!-- Ungrouped normal regions --}}
      <div class="dtm-instance-block dtm-ungrouped-block">
        <div class="dtm-instance-header{{#if isUngroupedActive}} dtm-instance-active{{/if}}"
             data-action="activateUngrouped"
             title="Regions drawn while no group is active land here.">
          <span class="dtm-instance-chevron dtm-ungrouped-icon"><i class="fas fa-folder-open"></i></span>
          <span class="dtm-ungrouped-label">Ungrouped</span>
          <span class="dtm-badge">{{ungroupedRegions.length}}</span>
        </div>
        <div class="dtm-instance-regions">
          {{#each ungroupedRegions}}
          <div class="dtm-region-item{{#if this.isActive}} dtm-region-active{{/if}}"
               data-region-id="{{this.id}}" draggable="true">
            <input type="text" class="dtm-region-name" value="{{this.name}}" placeholder="Table name">
            <span class="dtm-badge dtm-mode-badge dtm-mode-{{this.mode}}" title="Extraction mode">{{this.mode}}</span>
            <span class="dtm-badge dtm-page-badge">p.{{this.page}}</span>
            <span class="dtm-badge">{{this.entryCount}} rows</span>
            <button type="button" data-action="previewRegion" title="Preview / hide preview">
              <i class="fas fa-eye"></i>
            </button>
            <button type="button" data-action="deleteRegion" title="Delete region">
              <i class="fas fa-trash"></i>
            </button>
          </div>
          {{/each}}
        </div>
      </div>

      {{#unless hasAnyContent}}
      <div class="dtm-region-empty">
        Draw selection boxes over table regions in the PDF to add them here.
      </div>
      {{/unless}}
    </div>

    {{#if activeRegion}}
    <div class="dtm-preview-panel">
      <div class="dtm-preview-header">
        <span class="dtm-preview-title">{{activeRegion.name}}</span>
        {{#if activeRegion.isMultiColumn}}
        <span class="dtm-badge">{{activeRegion.columns.length}} columns</span>
        {{/if}}
      </div>
      {{#if activeRegion.isMultiColumn}}
        {{#each activeRegion.columns}}
        <div class="dtm-preview-col-block">
          <div class="dtm-preview-col-header">{{this.header}}</div>
          {{#each this.entries}}
          <div class="dtm-preview-row">
            <span class="dtm-preview-range">{{this.low}}</span>
            <span class="dtm-preview-name">{{this.name}}</span>
          </div>
          {{/each}}
        </div>
        {{/each}}
      {{else}}
        {{#each activeRegion.entries}}
        <div class="dtm-preview-row">
          <span class="dtm-preview-range">{{this.low}}</span>
          <span class="dtm-preview-name">{{this.name}}</span>
        </div>
        {{/each}}
        {{#unless activeRegion.entries.length}}
        <div class="dtm-region-empty">No data extracted — try a larger region.</div>
        {{/unless}}
      {{/if}}
    </div>
    {{/if}}

    <div class="dtm-scanner-footer">
      <div class="dtm-scanner-options">
        <label class="dtm-option-row">
          <input type="checkbox" name="usePrefix" {{#if usePrefix}}checked{{/if}}>
          Add prefix to table names:
          <input type="text" name="tablePrefix" value="{{tablePrefix}}" placeholder="e.g. Traveller" class="dtm-prefix-input" {{#unless usePrefix}}disabled{{/unless}}>
        </label>
        <label class="dtm-option-row">
          <input type="checkbox" name="makeCompound" {{#if makeCompound}}checked{{/if}}>
          Create compound table for multi-column regions
        </label>
        <label class="dtm-option-row">
          <input type="checkbox" name="createInstanceFolders" {{#if createInstanceFolders}}checked{{/if}}>
          Create a folder per instance (e.g. Elf, Dwarf)
        </label>
      </div>
      <div class="dtm-dialog-buttons">
        <button type="button" data-action="createTables" class="dtm-btn-primary"
                {{#unless hasRegions}}disabled{{/unless}}>
          <i class="fas fa-check"></i> Create Tables
        </button>
        <button type="button" data-action="cancel" class="dtm-btn-secondary">
          <i class="fas fa-times"></i> Cancel
        </button>
      </div>
    </div>

  </div>
</div>
